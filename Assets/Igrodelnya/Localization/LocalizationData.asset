  - Key: UI/Profession/Definition/trader/Perk2
    Translations:
    - "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439
      \u0437\u0430\u043F\u0430\u0441 \u043C\u043E\u043D\u0435\u0442"

  - Key: UI/Profession/Definition/hunter/Perk2
    Translations:
    - "\u0411\u044B\u0441\u0442\u0440\u0435\u0435 \u0442\u0435\u043C\u043F \u0434\u0430\u043B\u044C\u043D\u0435\u0433\u043E
      \u0431\u043E\u044F"

  - Key: UI/Profession/Definition/pyro/Perk2
    Translations:
    - "\u0425\u043E\u0440\u043E\u0448 \u043F\u0440\u043E\u0442\u0438\u0432 \u0442\u043E\u043B\u0441\u0442\u044B\u0445
      \u0432\u0440\u0430\u0433\u043E\u0432"
